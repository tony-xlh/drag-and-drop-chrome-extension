{
  "manifest_version": 3,
  "name": "File Drag & Drop Upload",
  "version": "1.0",
  "description": "Select a file in the popup, then drag it into any web page's drop zone to upload.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drag & Drop Upload"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
